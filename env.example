# Environment Configuration
# Copy this file to .env and update with your actual values
# Command: cp env.example .env

# =====================================================
# Server Configuration
# =====================================================
NODE_ENV=development
PORT=3000
HOSTNAME=localhost

# =====================================================
# PostgreSQL Database Configuration
# =====================================================
DATABASE_USER=postgres
DATABASE_HOST=localhost
DATABASE_NAME=oneup
DATABASE_PASSWORD=your_postgres_password_here
DATABASE_PORT=5432

# =====================================================
# Session Configuration
# =====================================================
# IMPORTANT: Change this to a strong random string in production!
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-random-secret-key-in-production

# =====================================================
# Notes:
# =====================================================
# - Never commit the actual .env file to version control
# - The .env file is already in .gitignore
# - Update DATABASE_PASSWORD with your PostgreSQL password
# - Generate a strong SESSION_SECRET for production

